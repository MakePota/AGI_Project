<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    版本由 spring-boot-starter-parent 统一管理：所有 Spring 官方依赖都不用写版本号，
    这是 Spring Boot 项目最重要的一条依赖纪律——手写版本号迟早会出现
    "两个 Spring 模块版本不一致"这种极难排查的问题。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.agiproject</groupId>
  <artifactId>agi-server</artifactId>
  <version>0.1.0</version>
  <name>agi-server</name>
  <description>AGI Project 的业务服务：用户与任务数据、对前端的 API，并通过 HTTP 调用智能体引擎</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Web 层：提供 REST 接口与 SseEmitter（给前端推事件） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      WebClient：用来**消费** AGI_Agent 的 SSE 事件流。
      为什么要引入 webflux 而不用 RestClient：RestClient 面向"请求-响应"，
      读一条不会结束的流（SSE）不是它的用途。WebClient 是响应式的，
      天然处理"数据一段段来"。
      代价是 Reactor 也进了依赖树。这里明确只把它当 **客户端** 用——
      Web 层仍然是 Spring MVC（见 application.yml 的 web-application-type）。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- 持久化：JPA + MySQL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      表结构由 Flyway 管，不让 JPA 自动建表（见 application.yml 里的 ddl-auto=validate）。

      **这里必须用 Spring Boot 的 starter，不能只加 flyway-core。**
      Boot 4 把自动配置按技术拆成了独立模块（spring-boot-flyway / spring-boot-jdbc …），
      spring-boot-autoconfigure 里已经不含它们。只加 flyway-core 的后果是：
      **构建通过、启动也通过，但迁移一条都不执行**，直到 Hibernate 校验表结构时
      才报 "missing table"。实测踩过这一次。

      flyway-mysql 是 Flyway 自己的模块（Flyway 10 起把各数据库支持拆了出去），
      starter 不含它，不加会在启动时报"不支持的数据库"。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- 参数校验：@NotBlank 这类注解要靠它才生效 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
